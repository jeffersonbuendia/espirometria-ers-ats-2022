"""
Pruebas del motor de interpretación.

Cubren los siete patrones ventilatorios del ERS/ATS 2022, la gradación de
severidad por z-score, el criterio de respuesta broncodilatadora del 10 % del
predicho y los casos límite en los que el estándar exige abstenerse de
clasificar.
"""

import pytest

from informe_espirometria import EstandaresERS2022
from interpretation import (
    bronchodilator_details,
    bronchodilator_response,
    classify_pattern,
    effective_z,
    generate_conclusion,
    is_low,
    severity_from_fev1_zscore,
)
from models import LungVolumes, PatientData, SpirometryValue


def value(parameter, unit="L", **kwargs):
    return SpirometryValue(parameter=parameter, unit=unit, **kwargs)


def build(ratio, fvc, fev1):
    """Construye el trío de parámetros a partir de tuplas (basal, pred, lln, post)."""
    def make(name, unit, datos):
        basal, pred, lln, post = datos
        return value(name, unit=unit, baseline=basal, predicted=pred,
                     lln=lln, post=post)
    return {
        "FEV1/FVC": make("FEV1/FVC", "%", ratio),
        "FVC": make("FVC", "L", fvc),
        "FEV1": make("FEV1", "L", fev1),
    }


ADULTO = PatientData(name="Adulto", age_years=60.0, sex="Masculino",
                     height_cm=170.0, weight_kg=70.0)
NINO = PatientData(name="Niño", age_years=10.0, sex="Femenino",
                   height_cm=140.0, weight_kg=35.0)


# ---------------------------------------------------------------- z-score
def test_z_estimado_coincide_con_lin():
    """En el LIN exacto el z estimado debe ser -1,645."""
    assert EstandaresERS2022.z_desde_lln(2.30, 2.84, 2.30) == pytest.approx(-1.645)


def test_z_suministrado_tiene_prioridad_sobre_el_estimado():
    v = value("FEV1", baseline=2.00, predicted=3.00, lln=2.40, z_score=-1.10)
    assert effective_z(v) == -1.10


def test_is_low_usa_el_zscore_como_criterio_primario():
    v = value("FEV1", baseline=2.00, predicted=3.00, lln=2.40, z_score=-1.10)
    assert is_low(v) is False


# --------------------------------------------------------------- severidad
@pytest.mark.parametrize("z,esperado", [
    (0.5, "sin reducción"),
    (-1.60, "sin reducción"),
    (-2.00, "leve"),
    (-3.50, "moderada"),
    (-4.50, "grave"),
    (None, "no clasificable"),
])
def test_severidad_por_zscore(z, esperado):
    assert severity_from_fev1_zscore(z) == esperado


# ----------------------------------------------------------------- patrones
def test_patron_normal():
    valores = build(ratio=(79.0, 78.0, 68.0, None),
                    fvc=(4.30, 4.20, 3.40, None),
                    fev1=(3.40, 3.30, 2.60, None))
    assert classify_pattern(valores).etiqueta == "Normal"


def test_patron_obstructivo():
    valores = build(ratio=(55.0, 78.0, 68.0, None),
                    fvc=(4.00, 4.20, 3.40, None),
                    fev1=(2.20, 3.30, 2.60, None))
    assert classify_pattern(valores).etiqueta == "Obstructivo"


def test_patron_mixto_requiere_volumenes_sin_tlc():
    valores = build(ratio=(59.6, 78.0, 68.0, None),
                    fvc=(2.60, 4.20, 3.40, None),
                    fev1=(1.55, 3.30, 2.60, None))
    patron = classify_pattern(valores)
    assert patron.etiqueta == "Mixto (sospecha)"
    assert patron.requiere_volumenes is True


